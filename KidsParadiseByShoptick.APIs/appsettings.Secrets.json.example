{
  "GoogleOAuth": {
    "ClientId": "YOUR-WEB-CLIENT-ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR-CLIENT-SECRET"
  },
  "MetaSocial": {
    "Enabled": true,
    "AppSecret": "YOUR-META-APP-SECRET",
    "FacebookPageId": "YOUR-FACEBOOK-PAGE-ID",
    "InstagramBusinessAccountId": "YOUR-INSTAGRAM-BUSINESS-ACCOUNT-ID"
  },
  "TikTokSocial": {
    "Enabled": true,
    "ClientKey": "YOUR-TIKTOK-CLIENT-KEY",
    "ClientSecret": "YOUR-TIKTOK-CLIENT-SECRET"
  },
  "PinterestSocial": {
    "Enabled": true,
    "AppId": "YOUR-PINTEREST-APP-ID",
    "AppSecret": "YOUR-PINTEREST-APP-SECRET",
    "BoardId": "",
    "DefaultBoardName": "Kids Paradise Toys"
  }
}
