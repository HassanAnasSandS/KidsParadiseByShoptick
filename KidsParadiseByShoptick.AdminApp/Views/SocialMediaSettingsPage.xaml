<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KidsParadiseByShoptick.AdminApp.ViewModels"
             xmlns:models="clr-namespace:KidsParadiseByShoptick.AdminApp.Models"
             x:Class="KidsParadiseByShoptick.AdminApp.Views.SocialMediaSettingsPage"
             x:DataType="vm:SocialMediaSettingsViewModel"
             Title="Social Media Settings"
             BackgroundColor="{StaticResource PageBg}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#dc2626"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource NullToBool}}" />

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Meta Setup Checklist" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Verify Facebook, Instagram and WhatsApp catalog requirements one by one."
                           FontSize="12" TextColor="#64748b" />
                    <Label Text="{Binding MetaSummary}" FontSize="13" TextColor="#334155" />

                    <Button Text="Check Requirements"
                            Command="{Binding CheckMetaRequirementsCommand}"
                            BackgroundColor="#0f766e"
                            TextColor="White"
                            IsEnabled="{Binding IsCheckingMeta, Converter={StaticResource InverseBool}}" />
                    <ActivityIndicator IsRunning="{Binding IsCheckingMeta}" IsVisible="{Binding IsCheckingMeta}" Color="#0f766e" />

                    <CollectionView ItemsSource="{Binding MetaRequirements}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MetaRequirementCheckModel">
                                <Frame Padding="12" Margin="0,4" CornerRadius="10"
                                       BorderColor="#e2e8f0"
                                       BackgroundColor="#f8fafc">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding Step, StringFormat='Step {0}'}"
                                               FontAttributes="Bold"
                                               TextColor="#1a6fe8"
                                               VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding Status}" FontSize="12" TextColor="#64748b" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Start">
                                            <Label Text="✓" FontSize="18" TextColor="#16a34a"
                                                   IsVisible="{Binding IsMet}" />
                                            <Label Text="✗" FontSize="18" TextColor="#dc2626"
                                                   IsVisible="{Binding IsMet, Converter={StaticResource InverseBool}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SocialMediaSettingsViewModel}}, Path=ShowFixCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Tap any step for fix instructions." FontSize="11" TextColor="#94a3b8" />

                    <Label Text="Link Catalog (Step 2)" FontAttributes="Bold" FontSize="13" Margin="0,8,0,0" />
                    <Label Text="If catalog exists in Commerce Manager but Step 2 fails, paste Catalog ID and link."
                           FontSize="11" TextColor="#64748b" />
                    <Entry Placeholder="Commerce Manager Catalog ID"
                           Text="{Binding CatalogIdToLink}"
                           Keyboard="Numeric" />
                    <Button Text="Link Catalog to WhatsApp"
                            Command="{Binding LinkCatalogCommand}"
                            BackgroundColor="#7c3aed"
                            TextColor="White"
                            IsEnabled="{Binding IsCheckingMeta, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Google Merchant Center" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Product feed auto-updates when you Create/Update/Delete a toy or when stock changes. Register this URL once in Merchant Center (Products → Feeds)."
                           FontSize="12" TextColor="#64748b" />
                    <Label Text="{Binding GoogleMerchantFeedUrl}"
                           FontSize="12"
                           TextColor="#0f172a"
                           LineBreakMode="CharacterWrap" />
                    <Button Text="Copy Feed URL"
                            Command="{Binding CopyGoogleMerchantFeedUrlCommand}"
                            BackgroundColor="#e2e8f0"
                            TextColor="#334155" />
                    <Button Text="Open Feed"
                            Command="{Binding OpenGoogleMerchantFeedCommand}"
                            BackgroundColor="#1a73e8"
                            TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TikTok" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Photos post from the server with Facebook/Instagram. Videos upload directly from this app on Save."
                           FontSize="12" TextColor="#64748b" />
                    <Label Text="{Binding TikTokSummary}" FontSize="13" TextColor="#334155" />

                    <Button Text="Refresh Status"
                            Command="{Binding RefreshTikTokStatusCommand}"
                            BackgroundColor="#e2e8f0"
                            TextColor="#334155"
                            IsEnabled="{Binding IsCheckingTikTok, Converter={StaticResource InverseBool}}" />

                    <Button Text="Connect TikTok"
                            Command="{Binding ConnectTikTokCommand}"
                            BackgroundColor="#111827"
                            TextColor="White"
                            IsVisible="{Binding TikTokConnected, Converter={StaticResource InverseBool}}"
                            IsEnabled="{Binding IsCheckingTikTok, Converter={StaticResource InverseBool}}" />

                    <Button Text="Disconnect TikTok"
                            Command="{Binding DisconnectTikTokCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#dc2626"
                            BorderColor="#fecaca"
                            BorderWidth="1"
                            IsVisible="{Binding TikTokConnected}"
                            IsEnabled="{Binding IsCheckingTikTok, Converter={StaticResource InverseBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsCheckingTikTok}" IsVisible="{Binding IsCheckingTikTok}" Color="#111827" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pinterest" FontAttributes="Bold" FontSize="16" />
                    <Label Text="On toy Create/Update (social posting on), a Pin is created with photo + product link. Board is auto-created as Kids Paradise Toys if needed."
                           FontSize="12" TextColor="#64748b" />
                    <Label Text="{Binding PinterestSummary}" FontSize="13" TextColor="#334155" />

                    <Button Text="Refresh Status"
                            Command="{Binding RefreshPinterestStatusCommand}"
                            BackgroundColor="#e2e8f0"
                            TextColor="#334155"
                            IsEnabled="{Binding IsCheckingPinterest, Converter={StaticResource InverseBool}}" />

                    <Button Text="Connect Pinterest"
                            Command="{Binding ConnectPinterestCommand}"
                            BackgroundColor="#E60023"
                            TextColor="White"
                            IsVisible="{Binding PinterestConnected, Converter={StaticResource InverseBool}}"
                            IsEnabled="{Binding IsCheckingPinterest, Converter={StaticResource InverseBool}}" />

                    <Button Text="Disconnect Pinterest"
                            Command="{Binding DisconnectPinterestCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#dc2626"
                            BorderColor="#fecaca"
                            BorderWidth="1"
                            IsVisible="{Binding PinterestConnected}"
                            IsEnabled="{Binding IsCheckingPinterest, Converter={StaticResource InverseBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsCheckingPinterest}" IsVisible="{Binding IsCheckingPinterest}" Color="#E60023" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="YouTube Description" FontAttributes="Bold" />
                    <Label Text="Used as the video description when uploading to YouTube from toy edit."
                           FontSize="12" TextColor="#64748b" />
                    <Editor Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="120"
                            Placeholder="Enter YouTube video description…" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="14" CornerRadius="12" BorderColor="#e2e8f0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tags" FontAttributes="Bold" />
                    <Label Text="Used on Facebook, Instagram, TikTok, Pinterest, and YouTube uploads. Separate with spaces or commas (e.g. #KidsParadise #Toys)."
                           FontSize="12" TextColor="#64748b" />
                    <Editor Text="{Binding Tags}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            Placeholder="#KidsParadise #Toys #Karachi" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Settings"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#1a6fe8"
                    TextColor="White"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
