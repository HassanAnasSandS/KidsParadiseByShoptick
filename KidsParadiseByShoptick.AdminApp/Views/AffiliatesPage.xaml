<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KidsParadiseByShoptick.AdminApp.Models"
             xmlns:vm="clr-namespace:KidsParadiseByShoptick.AdminApp.ViewModels"
             x:Class="KidsParadiseByShoptick.AdminApp.Views.AffiliatesPage"
             x:Name="ThisPage"
             x:DataType="vm:AffiliatesViewModel"
             Title="Affiliates"
             BackgroundColor="{StaticResource PageBg}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
        <ToolbarItem Text="Refresh" Command="{Binding LoadCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*" Padding="12">
        <SearchBar Grid.Row="0" Placeholder="Search partners..." Text="{Binding SearchText}" />
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AffiliatePartnerModel">
                        <Frame Margin="0,4" Padding="12" CornerRadius="12" HasShadow="False" BorderColor="#e2e8f0">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Code, StringFormat='Code: {0}'}" FontSize="12" TextColor="#64748b" />
                                        <Label Text="{Binding ContactSummary}"
                                               IsVisible="{Binding ContactSummary, Converter={StaticResource NullToBool}}"
                                               FontSize="11" TextColor="#64748b" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding StatusLabel}" FontSize="12" TextColor="#1a6fe8" />
                                        <Label Text="{Binding SummaryText}" FontSize="11" TextColor="#64748b" />
                                        <Label Text="{Binding BalanceText}" FontSize="12" FontAttributes="Bold" TextColor="#0f766e" />
                                    </VerticalStackLayout>
                                </Grid>
                                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                    <Button Text="WA" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                            BackgroundColor="#25D366" TextColor="White" FontAttributes="Bold"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWhatsAppCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Whatsapp, Converter={StaticResource NullToBool}}" />
                                    <Button Text="Welcome" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                            BackgroundColor="#0f766e" TextColor="White"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CopyMessageCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Link" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CopyLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Ledger" FontSize="12" Padding="10,4" Margin="0,0,6,0" BackgroundColor="#0f766e" TextColor="White"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.LedgerCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Edit" FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Del" FontSize="12" Padding="10,4" BackgroundColor="#dc2626" TextColor="White"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
